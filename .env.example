# Copy to .env (gitignored) and fill in real values.
# Spring Boot reads these via application.properties ${ENV:default} placeholders.
# Production MUST set every secret listed as "required in production".
# Do not put live credentials in this file.

# --- MongoDB (required in production; localhost defaults are for local only) ---
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/prwatechDB
SKILLAMA_MONGODB_URI=mongodb://localhost:27017/skillamaDB

# --- JWT (required in production: strong random value, then rotate if it was ever committed) ---
JWT_SECRET_KEY=local-dev-only-not-for-production

# --- Swagger HTTP Basic (local defaults are NOT production secrets) ---
SWAGGER_ENABLED=true
SWAGGER_USER=dev
SWAGGER_PASSWORD=dev-only-change-me

# --- Auth0 ---
# Domain and client id are public identifiers. Client secret is required for Auth0 token exchange.
PRWATECH_AUTH0_CLIENT_DOMAIN=
PRWATECH_AUTH0_CLIENT_ID=
PRWATECH_AUTH0_CLIENT_SECRET=

# --- Payments (Razorpay) ---
PRWATECH_RZ_KEY=
PRWATECH_RZ_SECRET=

# --- Twilio ---
PRWATECH_TWILIO_ACCOUNT_SID=
PRWATECH_TWILIO_AUTH_TOKEN=

# --- SMS / email provider keys ---
PRWATECH_FAST2SMS_API_KEY=
PRWATECH_EMAIL_ACCESS_KEY=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# --- Internal service keys (must match ai-tutor) ---
AI_USAGE_API_KEY=
SKILLAMA_AI_INTERNAL_KEY=
KB_SYNC_SECRET=

# --- Firebase Cloud Messaging (required for push notifications) ---
# Preferred: path to a gitignored copy of firebase-service-account.json.example
FIREBASE_CREDENTIALS_FILE=
# Alternative: raw service-account JSON (do not commit). GOOGLE_APPLICATION_CREDENTIALS also works.
# FIREBASE_CREDENTIALS_JSON=

# --- Optional first-owner bootstrap (only if FirstOwnerSetupScript is enabled) ---
# FIRST_OWNER_PASSWORD=
